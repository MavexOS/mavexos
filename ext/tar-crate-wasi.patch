diff -ruN a/src/header.rs b/src/header.rs
--- a/src/header.rs	2006-07-23 21:21:28.000000000 -0400
+++ b/src/header.rs	2026-11-09 13:25:08.260294347 -0500
@@ -782,7 +782,32 @@
     #[cfg(target_arch = "wasm32")]
     #[allow(unused_variables)]
     fn fill_platform_from(&mut self, meta: &fs::Metadata, mode: HeaderMode) {
-        unimplemented!();
+        let _ = mode;
+        let mtime = meta
+            .modified()
+            .ok()
+            .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
+            .map(|d| d.as_secs())
+            .unwrap_or(0);
+        self.set_mtime(mtime);
+        self.set_uid(0);
+        self.set_gid(0);
+        let ft = meta.file_type();
+        self.set_entry_type(if ft.is_dir() {
+            EntryType::Directory
+        } else if ft.is_symlink() {
+            EntryType::Symlink
+        } else {
+            EntryType::Regular
+        });
+        match crate::mavex::stat_cur() {
+            Some((m, u, g)) => {
+                self.set_mode(m & 0o7777);
+                self.set_uid(u as u64);
+                self.set_gid(g as u64);
+            }
+            None => self.set_mode(if meta.is_dir() { 0o755 } else { 0o644 }),
+        }
     }
 
     #[cfg(all(unix, not(target_arch = "wasm32")))]
