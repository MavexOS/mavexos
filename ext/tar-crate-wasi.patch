diff -ruN a/src/mavex.rs b/src/mavex.rs
--- a/src/mavex.rs	1969-12-31 19:00:00.000000000 -0500
+++ b/src/mavex.rs	2026-11-09 13:20:17.898705449 -0500
@@ -0,0 +1,33 @@
+//! MavexOS: real modes/owners through host imports (wasip1 std exposes none).
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+
+#[link(wasm_import_module = "mavex")]
+unsafe extern "C" {
+    fn statx(p: *const u8, n: usize, out: *mut u32) -> i32;
+    fn chmod(p: *const u8, n: usize, mode: u32) -> i32;
+}
+
+thread_local!(static CUR: RefCell<Option<PathBuf>> = const { RefCell::new(None) });
+
+pub fn set_cur(p: &Path) {
+    CUR.with(|c| *c.borrow_mut() = Some(p.to_path_buf()));
+}
+
+pub fn stat_cur() -> Option<(u32, u32, u32)> {
+    let p = CUR.with(|c| c.borrow().clone())?;
+    let s = p.to_str()?;
+    let mut o = [0u32; 6];
+    if unsafe { statx(s.as_ptr(), s.len(), o.as_mut_ptr()) } < 0 {
+        return None;
+    }
+    Some((o[0], o[1], o[2]))
+}
+
+pub fn chmod_path(p: &Path, mode: u32) -> std::io::Result<()> {
+    let s = p.to_str().ok_or_else(|| std::io::Error::from(std::io::ErrorKind::InvalidInput))?;
+    if unsafe { chmod(s.as_ptr(), s.len(), mode) } < 0 {
+        return Err(std::io::Error::from(std::io::ErrorKind::PermissionDenied));
+    }
+    Ok(())
+}
